# 中文语料轨：原始 collection 太大（3.5GB），只提交派生的小文件
# 演示「增量索引」时产生的临时索引目录（docs/演示清单.md 演示 9）
data/tmp_*/
data/zh/T2Ranking/collection.tsv
data/zh/T2Ranking/dev.bm25.tsv
data/zh/T2Ranking/dev.dpr.tsv
# 向量索引与 embedding 分片是派生文件（各 119MB），可由 --device cuda 在 ~43 分钟内重建；
# 评估结果（data/reports/runs/ 的 jsonl 存档）已提交，足以复算所有指标。
data/zh/T2Ranking/*.faiss
data/zh/T2Ranking/emb_cache/
data/zh/T2Ranking/dense_eval.log
# 导出给问答入口用的同构索引（chunks.pkl 61MB + faiss.index 119MB），
# 由 `python -m ingest.export_zh_index` 从语料 TSV + embedding 分片重建
data/zh/T2Ranking/index/

# 原始 QA 数据集（parquet，可从 HuggingFace 重新下载；单文件最大 237MB，超出 GitHub 单文件上限）
data/raw_qa/

# 派生的检索索引与候选池（可由评估脚本重建，不入库）
data/qa/index/
data/qa/hybrid_candidates*.pkl

# AI 生成的分步实施计划（保留在本地，不入库）
docs/plans/

# 指向本地 conda 环境内 streamlit 包的符号链接（克隆后必为坏链）
.agents/
